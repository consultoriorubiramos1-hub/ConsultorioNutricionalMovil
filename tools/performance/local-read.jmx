<?xml version='1.0' encoding='utf-8'?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
 <hashTree>
  <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="API local: lecturas ficticias" enabled="true">
   <boolProp name="TestPlan.functional_mode">false</boolProp>
   <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
   <elementProp name="TestPlan.user_defined_variables" elementType="Arguments">
    <collectionProp name="Arguments.arguments">
     <elementProp name="cnmBearer" elementType="Argument">
      <stringProp name="Argument.name">cnmBearer</stringProp>
      <stringProp name="Argument.value">${__BeanShell(System.getenv("CNM_JMETER_TOKEN"))}</stringProp>
      <stringProp name="Argument.metadata">=</stringProp>
     </elementProp>
    </collectionProp>
   </elementProp>
  </TestPlan>
  <hashTree>
   <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Carga acotada" enabled="true">
    <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
    <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Lecturas" enabled="true">
     <boolProp name="LoopController.continue_forever">false</boolProp>
     <intProp name="LoopController.loops">-1</intProp>
    </elementProp>
    <stringProp name="ThreadGroup.num_threads">${__P(cnm.threads,1)}</stringProp>
    <stringProp name="ThreadGroup.ramp_time">${__P(cnm.ramp,1)}</stringProp>
    <boolProp name="ThreadGroup.scheduler">true</boolProp>
    <stringProp name="ThreadGroup.duration">${__P(cnm.seconds,30)}</stringProp>
    <stringProp name="ThreadGroup.delay">0</stringProp>
    <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
   </ThreadGroup>
   <hashTree>
    <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Autorizacion efimera" enabled="true">
     <collectionProp name="HeaderManager.headers">
      <elementProp name="" elementType="Header">
       <stringProp name="Header.name">Authorization</stringProp>
       <stringProp name="Header.value">Bearer ${cnmBearer}</stringProp>
      </elementProp>
      <elementProp name="" elementType="Header">
       <stringProp name="Header.name">Accept</stringProp>
       <stringProp name="Header.value">application/json</stringProp>
      </elementProp>
     </collectionProp>
    </HeaderManager>
    <hashTree />
    <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="Pausa de un segundo por peticion" enabled="true">
     <stringProp name="ConstantTimer.delay">1000</stringProp>
    </ConstantTimer>
    <hashTree />
    <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="HTTP 200" enabled="true">
     <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
     <stringProp name="Assertion.custom_message">HTTP distinto de 200</stringProp>
     <boolProp name="Assertion.assume_success">false</boolProp>
     <intProp name="Assertion.test_type">8</intProp>
     <collectionProp name="Asserion.test_strings">
      <stringProp name="49586">200</stringProp>
     </collectionProp>
    </ResponseAssertion>
    <hashTree />
    <org.apache.jmeter.assertions.jmespath.JMESPathAssertion guiclass="org.apache.jmeter.assertions.jmespath.gui.JMESPathAssertionGui" testclass="org.apache.jmeter.assertions.jmespath.JMESPathAssertion" testname="Contrato comun e identidad A" enabled="true">
     <stringProp name="JMES_PATH">type(@) == 'object' &amp;&amp; ok == `true` &amp;&amp; type(data) == 'object' &amp;&amp; data.username == 'dast_patient_a'</stringProp>
     <stringProp name="EXPECTED_VALUE">true</stringProp>
     <boolProp name="JSONVALIDATION">true</boolProp>
     <boolProp name="EXPECT_NULL">false</boolProp>
     <boolProp name="INVERT">false</boolProp>
     <boolProp name="ISREGEX">false</boolProp>
    </org.apache.jmeter.assertions.jmespath.JMESPathAssertion>
    <hashTree />
    <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="auth-me" enabled="true">
     <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
      <collectionProp name="Arguments.arguments" />
     </elementProp>
     <stringProp name="HTTPSampler.domain">127.0.0.1</stringProp>
     <stringProp name="HTTPSampler.port">3300</stringProp>
     <stringProp name="HTTPSampler.protocol">http</stringProp>
     <stringProp name="HTTPSampler.path">/api/mobile/auth/me</stringProp>
     <stringProp name="HTTPSampler.method">GET</stringProp>
     <stringProp name="HTTPSampler.implementation">HttpClient4</stringProp>
     <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
     <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
     <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
     <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
     <stringProp name="HTTPSampler.connect_timeout">3000</stringProp>
     <stringProp name="HTTPSampler.response_timeout">5000</stringProp>
    </HTTPSamplerProxy>
    <hashTree>
     <org.apache.jmeter.assertions.jmespath.JMESPathAssertion guiclass="org.apache.jmeter.assertions.jmespath.gui.JMESPathAssertionGui" testclass="org.apache.jmeter.assertions.jmespath.JMESPathAssertion" testname="Contrato de auth-me" enabled="true">
      <stringProp name="JMES_PATH">data.rol_id == `2`</stringProp>
      <stringProp name="EXPECTED_VALUE">true</stringProp>
      <boolProp name="JSONVALIDATION">true</boolProp>
      <boolProp name="EXPECT_NULL">false</boolProp>
      <boolProp name="INVERT">false</boolProp>
      <boolProp name="ISREGEX">false</boolProp>
     </org.apache.jmeter.assertions.jmespath.JMESPathAssertion>
     <hashTree />
    </hashTree>
    <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="perfil" enabled="true">
     <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
      <collectionProp name="Arguments.arguments" />
     </elementProp>
     <stringProp name="HTTPSampler.domain">127.0.0.1</stringProp>
     <stringProp name="HTTPSampler.port">3300</stringProp>
     <stringProp name="HTTPSampler.protocol">http</stringProp>
     <stringProp name="HTTPSampler.path">/api/mobile/perfil</stringProp>
     <stringProp name="HTTPSampler.method">GET</stringProp>
     <stringProp name="HTTPSampler.implementation">HttpClient4</stringProp>
     <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
     <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
     <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
     <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
     <stringProp name="HTTPSampler.connect_timeout">3000</stringProp>
     <stringProp name="HTTPSampler.response_timeout">5000</stringProp>
    </HTTPSamplerProxy>
    <hashTree>
     <org.apache.jmeter.assertions.jmespath.JMESPathAssertion guiclass="org.apache.jmeter.assertions.jmespath.gui.JMESPathAssertionGui" testclass="org.apache.jmeter.assertions.jmespath.JMESPathAssertion" testname="Contrato de perfil" enabled="true">
      <stringProp name="JMES_PATH">data.first_lastname == 'Paciente' &amp;&amp; data.second_lastname == 'A' &amp;&amp; type(data.email) == 'string' &amp;&amp; ends_with(data.email, '@example.test') &amp;&amp; !contains(keys(data), 'password_hash') &amp;&amp; !contains(keys(data), 'notes')</stringProp>
      <stringProp name="EXPECTED_VALUE">true</stringProp>
      <boolProp name="JSONVALIDATION">true</boolProp>
      <boolProp name="EXPECT_NULL">false</boolProp>
      <boolProp name="INVERT">false</boolProp>
      <boolProp name="ISREGEX">false</boolProp>
     </org.apache.jmeter.assertions.jmespath.JMESPathAssertion>
     <hashTree />
    </hashTree>
   </hashTree>
  </hashTree>
 </hashTree>
</jmeterTestPlan>
