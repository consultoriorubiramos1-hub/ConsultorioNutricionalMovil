# Copiar a .env.test.local; Node NO carga automáticamente este archivo.
# Ejecutar: node --env-file=.env.test.local scripts/run-node-tests.cjs live
TEST_ENVIRONMENT=isolated
TEST_API_URL=
TEST_API_ALLOWED_ORIGIN=
PRODUCTION_API_URL=
TEST_BACKEND_REPOSITORY=
# Commit completo revisado del backend (40 caracteres), nunca una rama mutable.
TEST_BACKEND_REF=
# Ruta relativa del driver .cjs dentro del checkout .test-backend.
TEST_BACKEND_DRIVER=
# Exclusivamente una BD de pruebas; nunca DATABASE_URL de producción.
TEST_DATABASE_URL=
TEST_DATABASE_ALLOWED_HOST=
